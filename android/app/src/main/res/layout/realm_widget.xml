<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/card" android:padding="10dp">
 <ImageView android:id="@+id/scene" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/shire_scene" android:scaleType="centerCrop" android:alpha="0.28" android:contentDescription="@null"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:id="@+id/emblem" android:layout_width="42dp" android:layout_height="46dp" android:src="@drawable/realm_orb" android:contentDescription="@null"/>
   <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingStart="8dp" android:paddingEnd="0dp" android:fontFamily="serif" android:textSize="24sp" android:textColor="#F4ECDC" android:text="The Shire"/>
  </LinearLayout>
  <TextView android:id="@+id/updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Not synced yet" android:textColor="#BDCCE0" android:textSize="11sp"/>
  <LinearLayout android:id="@+id/cards" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
   <LinearLayout android:id="@+id/card_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/card" android:layout_marginBottom="6dp">
    <TextView android:id="@+id/card_title_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your realm, at a glance" android:textColor="#E5CD92" android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/card_body_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp" android:text="Tap Sync to save a snapshot." android:textColor="#F4ECDC" android:textSize="13sp" android:maxLines="5" android:ellipsize="end"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/card_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/card" android:layout_marginBottom="6dp">
    <TextView android:id="@+id/card_title_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5CD92" android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/card_body_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp" android:textColor="#F4ECDC" android:textSize="13sp" android:maxLines="5" android:ellipsize="end"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/card_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="@drawable/card" android:layout_marginBottom="6dp">
    <TextView android:id="@+id/card_title_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#E5CD92" android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/card_body_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="4dp" android:textColor="#F4ECDC" android:textSize="13sp" android:maxLines="5" android:ellipsize="end"/>
   </LinearLayout>
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
   <TextView android:id="@+id/open" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button" android:gravity="center" android:text="Open" android:textColor="#F4ECDC" android:textSize="13sp"/>
   <TextView android:id="@+id/sync" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/button" android:gravity="center" android:text="Sync" android:textColor="#F4ECDC" android:textSize="13sp"/>
  </LinearLayout>
  <TextView android:id="@+id/privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Cached on this phone · tap Sync to update" android:textColor="#BDCCE0" android:textSize="10sp" android:maxLines="2"/>
 </LinearLayout>
</FrameLayout>

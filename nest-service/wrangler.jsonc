{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sage-cabin-nest",
  "account_id": "5e6a580fb3f9a04573693f7c6c123fbd",
  "main": "private-worker.mjs",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-private",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "head_sampling_rate": 1,
    "redact_query_string": true
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://sage-cabin-nest.nest-service.workers.dev",
    "ACCESS_TEAM_DOMAIN": "https://noisy-moon-7c51.cloudflareaccess.com",
    "ACCESS_AUD": "921a367be80c010fe17577143be67669a88544f8f141a28de5268f8b134c5dbb",
    "OWNER_EMAIL": "abdickers@gmail.com",
    "NEST_PROJECT_ID": "36aad5a3-335e-4665-a687-9783ae584571",
    "GOOGLE_CLIENT_ID": "644801431816-9f7u70h62fipmebva3llupi2o17b1g80.apps.googleusercontent.com",
    "BUDGET_SECONDARY_EMAIL": "sage4997@gmail.com",
    "PLAID_ENV": "sandbox"
  },
  "triggers": {"crons": []},
  "d1_databases": [{"binding":"BUDGET_DB","database_name":"sage-home-budget","database_id":"51cdb6ed-7a8f-45ec-a6bb-e72f4b85fec3","migrations_dir":"migrations"}],
  "kv_namespaces": [
    {
      "binding": "NEST_KV",
      "id": "141d76a39b1e476dbe134dcf578f85a0"
    }
  ]
}
